#pragma once

// Engine version (ROADMAP P8). Generated by CMake from cmake/version.hpp.in
// (the project() version in the root CMakeLists.txt); installed with the SDK.
//
// The macros are the version of the headers a translation unit was compiled
// against; quat3d::version() is the version of the engine libraries the
// program linked. A game built against an installed SDK sees the same value
// in both; docs/sdk.md describes the versioning policy.

#define QUAT3D_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define QUAT3D_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define QUAT3D_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define QUAT3D_VERSION_STRING "@PROJECT_VERSION@"

namespace quat3d {

struct Version {
    int major = 0;
    int minor = 0;
    int patch = 0;

    friend constexpr bool operator==(const Version&, const Version&) = default;
};

// The engine libraries' version, compiled into engine_core.
[[nodiscard]] Version version() noexcept;

// "MAJOR.MINOR.PATCH", compiled into engine_core.
[[nodiscard]] const char* version_string() noexcept;

} // namespace quat3d
