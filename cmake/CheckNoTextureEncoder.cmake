# Fails when the game contains Basis Universal or ASTC encoder code: it links
# libktx's read-only library, so these symbols mean the full libktx (or the
# encoder) slipped into the shipped executable.
#   cmake -DNM=<nm> -DBINARY=<file> -P CheckNoTextureEncoder.cmake   (symbol table)
#   cmake -DMAP=<linker .map> -P CheckNoTextureEncoder.cmake         (MSVC)
if(MAP)
    if(NOT EXISTS "${MAP}")
        message(FATAL_ERROR "linker map ${MAP} not found (the game links with /MAP)")
    endif()
    file(READ "${MAP}" symbols)
    set(source "${MAP}")
elseif(NM AND BINARY)
    execute_process(COMMAND "${NM}" -C "${BINARY}"
        OUTPUT_VARIABLE symbols ERROR_VARIABLE nm_error RESULT_VARIABLE nm_result)
    if(NOT nm_result EQUAL 0)
        message(FATAL_ERROR "${NM} failed on ${BINARY}: ${nm_error}")
    endif()
    set(source "${BINARY}")
else()
    message(FATAL_ERROR "usage: -DNM=<nm> -DBINARY=<file> or -DMAP=<map> -P CheckNoTextureEncoder.cmake")
endif()
string(LENGTH "${symbols}" size)
if(size EQUAL 0)
    message(FATAL_ERROR "${source}: no symbols to inspect")
endif()
string(REGEX MATCHALL "[^\n]*(basis_compressor|astcenc_)[^\n]*" found "${symbols}")
list(LENGTH found count)
if(count GREATER 0)
    list(SUBLIST found 0 5 sample)
    string(REPLACE ";" "\n" sample "${sample}")
    message(FATAL_ERROR "${source} links texture encoder code (${count} symbols), e.g.\n${sample}")
endif()
message(STATUS "${source}: no texture encoder symbols")
